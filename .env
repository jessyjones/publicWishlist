THEME=https://raw.githubusercontent.com/anubisnekhet/AnuPpuccin/HEAD/theme.css
BASE_THEME=light
dgHomeLink=true
dgShowBacklinks=false
dgShowLocalGraph=false
dgShowGraphDepthControl=false
dgShowInlineTitle=false
dgShowFileTree=false
dgEnableSearch=true
dgShowToc=false
dgLinkPreview=true
dgShowTags=true
SITE_NAME_HEADER=Wishlist
TIMESTAMP_FORMAT=dd MMMM, yyyy h:mm a
USE_FULL_RESOLUTION_IMAGES=false
dgPassFrontmatter=false
STYLE_SETTINGS_CSS=body.css-settings-manager { } body.theme-light.css-settings-manager { } body.theme-dark.css-settings-manager { }
STYLE_SETTINGS_BODY_CLASSES=mod-linux is-frameless is-hidden-frameless obsidian-app styled-scrollbars theme-light show-inline-title is-floating-nav auto-full-screen show-ribbon show-view-header is-maximized css-settings-manager anp-td-none ctp-latte ctp-mocha ctp-accent-light-flamingo ctp-accent-rosewater anuppuccin-accent-toggle anp-no-highlight anp-latex-inline-text anp-latex-block-text anp-hide-external-link-icon anp-h1-red anp-h2-peach anp-h3-green anp-h4-teal anp-h5-lavender anp-h6-mauve anp-bold-red anp-italic-green anp-highlight-yellow anp-colorful-frame anp-custom-vault-toggle anp-file-icons anp-floating-header anp-collapse-folders anp-full-rainbow-color-toggle anp-fixed-status-bar anp-mini-tab-toggle anp-card-layout anp-hide-borders