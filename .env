THEME=https://raw.githubusercontent.com/kepano/obsidian-minimal/HEAD/theme.css
BASE_THEME=dark
dgHomeLink=true
dgShowBacklinks=false
dgShowLocalGraph=false
dgShowGraphDepthControl=false
dgShowInlineTitle=false
dgShowFileTree=false
dgEnableSearch=false
dgShowToc=false
dgLinkPreview=false
dgShowTags=true
SITE_NAME_HEADER=Wishlist
TIMESTAMP_FORMAT=dd MMMM, yyyy h:mm a
USE_FULL_RESOLUTION_IMAGES=false
dgPassFrontmatter=false
STYLE_SETTINGS_CSS=body.css-settings-manager { --tag-border-width: 2px; } body.theme-light.css-settings-manager { --cards-background: #FFFFFF; --cards-background-hover (hover): #FFFFFF; --tag-background: #C99DCE; --tag-color: #000000; --bg1: #F8ECEC; } body.theme-dark.css-settings-manager { }
STYLE_SETTINGS_BODY_CLASSES=mod-linux is-frameless is-hidden-frameless obsidian-app styled-scrollbars show-inline-title is-floating-nav auto-full-screen show-ribbon show-view-header css-settings-manager anp-td-none is-maximized theme-light callouts-default trim-cols checkbox-circle pdf-seamless-on pdf-invert-dark pdf-blend-light sidebar-tabs-default tab-names-off vault-profile-default ribbon-hidden maximize-tables-off tabs-default tab-stack-top minimal-tab-title-hover default
SITE_MAIN_LANGUAGE=en
SITE_BASE_URL=
SHOW_CREATED_TIMESTAMP=false
SHOW_UPDATED_TIMESTAMP=false
NOTE_ICON_DEFAULT=
NOTE_ICON_TITLE=false
NOTE_ICON_FILETREE=false
NOTE_ICON_INTERNAL_LINKS=false
NOTE_ICON_BACK_LINKS=false